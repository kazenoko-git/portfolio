---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { readingTime } from '../../lib/content';
import { entryDate, entryVisual } from '../../lib/presentation';
import ProjectImage from '../../components/ProjectImage.astro';
import { site } from '../../lib/site';
export async function getStaticPaths() {
  const collections = [
    'writing',
    'projects',
    'papers',
    'certifications',
  ] as const;
  const entries = (
    await Promise.all(
      collections.map((collection) => getCollection(collection)),
    )
  ).flat();
  return entries.map((entry) => ({
    params: { collection: entry.collection, slug: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const draft = 'draft' in entry.data && entry.data.draft;
const repoUrl = 'repoUrl' in entry.data ? entry.data.repoUrl : undefined;
const structuredData = {
  '@type':
    entry.collection === 'papers'
      ? 'ScholarlyArticle'
      : entry.collection === 'writing'
        ? 'BlogPosting'
        : entry.collection === 'projects'
          ? 'CreativeWork'
          : 'CreativeWork',
  name: entry.data.title,
  headline: entry.data.title,
  description: entry.data.summary,
  url: new URL(Astro.url.pathname, Astro.site).href,
  image: {
    '@type': 'ImageObject',
    url: new URL(entryVisual(entry).src, Astro.site).href,
    caption: entryVisual(entry).caption,
  },
  ...(entry.collection === 'projects' && entry.data.projectPeriod
    ? { temporalCoverage: entry.data.projectPeriod }
    : {}),
  ...(entry.data.source && entry.data.dateLabel !== 'Published'
    ? { dateModified: entry.data.source.updatedAt.toISOString() }
    : { datePublished: entry.data.date.toISOString() }),
  author:
    'authors' in entry.data
      ? entry.data.authors.map((name) => ({ '@type': 'Person', name }))
      : { '@type': 'Person', name: site.author },
  ...(repoUrl
    ? {
        subjectOf: {
          '@type': 'SoftwareSourceCode',
          name: entry.data.title,
          codeRepository: repoUrl,
        },
      }
    : {}),
  ...('issuer' in entry.data
    ? {
        provider: { '@type': 'Organization', name: entry.data.issuer },
      }
    : {}),
};
---

<Base
  title={entry.data.title}
  description={entry.data.summary}
  noindex={draft}
  structuredData={structuredData}
  article
>
  {entry.id === 'neuromorphic-npu' && (
    <div class="talos-scroll-progress" aria-hidden="true" />
  )}
  <div class="wrap article-top">
    <a href={`/${entry.collection}`} class="mono back-link">
      ← All {entry.collection}
    </a>
  </div>
  <header class:list={['wrap article-header', { 'talos-header': entry.id === 'neuromorphic-npu' }]}>
    <p class="eyebrow">{entry.data.tags.join(' / ')}</p>
    <h1>{entry.data.title}</h1>
    <p>{entry.data.summary}</p>
    <div class="article-meta mono">
      <span>
        {entry.collection === 'projects' && entry.data.projectPeriod
          ? 'Project period · '
          : ''}
        {entryDate(entry)}
      </span>
      <span>{readingTime(entry.body)} min read</span>
      <span>{entry.data.status}</span>
      {repoUrl && <a href={repoUrl}>Project repository ↗</a>}
    </div>
    {draft && (
      <div class="draft-notice">
        <strong>Unpublished draft outline</strong>
        <span>
          Technical content is awaiting verified source material. This page is
          excluded from RSS and search indexing.
        </span>
      </div>
    )}
  </header>
  <div class:list={['wrap article-art', { 'talos-cover': entry.id === 'neuromorphic-npu' }]}>
    <ProjectImage entry={entry} hero />
  </div>
  <div class="wrap article-grid">
    <aside class="toc">
      <p class="eyebrow">On this page</p>
      <nav aria-label="Table of contents">
        {headings
          .filter((h) => h.depth === 2)
          .map((h) => (
            <a href={`#${h.slug}`}>{h.text}</a>
          ))}
      </nav>
      <a href="#main" class="mono back-top">
        Back to top ↑
      </a>
    </aside>
    <article class:list={['prose', { 'talos-article': entry.id === 'neuromorphic-npu' }]}>
      {entry.data.source && (
        <p class="source-notice">
          Imported repository documentation. Claims and project status reflect
          the source.{' '}
          <a href={entry.data.source.url}>Read the source on GitHub ↗</a>
        </p>
      )}
      <Content />
      {entry.data.repositoryDocumentation && (
        <section>
          <h2>Repository documentation</h2>
          <p>
            Automatically imported from{' '}
            <a href={entry.data.repositoryDocumentation.url}>
              {entry.data.repositoryDocumentation.repo} ↗
            </a>
            . This documentation may differ from the project summary above; its
            claims and status reflect the source.
          </p>
          <div set:html={entry.data.repositoryDocumentation.html} />
        </section>
      )}
      {entry.data.links.length > 0 && (
        <section>
          <h2>Links & sources</h2>
          <ul>
            {entry.data.links.map((link) => (
              <li>
                <a href={link.url}>{link.label} ↗</a>
              </li>
            ))}
          </ul>
        </section>
      )}
      <div class="article-end">
        <span aria-hidden="true">✳</span>
        <a href={`/${entry.collection}`}>Back to {entry.collection} ↗</a>
      </div>
    </article>
  </div>
  <script>
    const talosArticle = document.querySelector('.talos-article');
    const reduceTalosMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (talosArticle && !reduceTalosMotion.matches) {
      const revealTargets = talosArticle.querySelectorAll(
        'h2, .talos-figure, .talos-equation, .score-card',
      );
      let scoreCardIndex = 0;
      const scrollTargets = Array.from(revealTargets, (target) => {
        const element = target as HTMLElement;
        element.setAttribute('data-scroll-reveal', '');
        const scoreCard = element.classList.contains('score-card');
        const stagger = scoreCard ? scoreCardIndex++ * 0.018 : 0;
        return { element, stagger };
      });
      talosArticle.classList.add('talos-scroll-js');
      let scrollFrame = 0;
      const updateTalosScroll = () => {
        if (scrollFrame) return;
        scrollFrame = requestAnimationFrame(() => {
          const viewportHeight = window.innerHeight || 1;
          const maxScroll =
            document.documentElement.scrollHeight - viewportHeight;
          document.documentElement.style.setProperty(
            '--talos-reading-progress',
            String(
              maxScroll > 0
                ? Math.max(0, Math.min(1, window.scrollY / maxScroll))
                : 0,
            ),
          );
          const measurements = scrollTargets.map((target) => ({
            ...target,
            rect: target.element.getBoundingClientRect(),
            previousY:
              Number.parseFloat(
                target.element.style.getPropertyValue('--scroll-y'),
              ) || 0,
            previousScale:
              Number.parseFloat(
                target.element.style.getPropertyValue('--scroll-scale'),
              ) || 1,
          }));
          measurements.forEach(
            ({ element, stagger, rect, previousY, previousScale }) => {
              const clamp = (value: number) =>
                Math.max(0, Math.min(1, value));
              const travel = clamp(
                (viewportHeight - (rect.top - previousY)) /
                  (viewportHeight + rect.height / previousScale) +
                  stagger,
              );
              const entering = clamp(travel / 0.2);
              const leaving = clamp((1 - travel) / 0.2);
              const visibility = Math.min(entering, leaving);
              const y = (1 - entering) * 52 - (1 - leaving) * 42;
              const scale = 0.985 + visibility * 0.015;
              element.style.setProperty(
                '--scroll-opacity',
                visibility.toFixed(3),
              );
              element.style.setProperty('--scroll-y', `${y.toFixed(1)}px`);
              element.style.setProperty('--scroll-scale', scale.toFixed(3));
              if (element.classList.contains('talos-decay'))
                element.style.setProperty(
                  '--decay-dash',
                  (1200 * (1 - entering)).toFixed(1),
                );
            },
          );
          scrollFrame = 0;
        });
      };
      window.addEventListener('scroll', updateTalosScroll, { passive: true });
      window.addEventListener('resize', updateTalosScroll, { passive: true });
      updateTalosScroll();
    }
    document.querySelectorAll('article :is(h2,h3)[id]').forEach((heading) => {
      const anchor = document.createElement('a');
      anchor.href = `#${heading.id}`;
      anchor.className = 'heading-anchor';
      anchor.textContent = '#';
      anchor.setAttribute('aria-label', `Link to ${heading.textContent}`);
      heading.append(anchor);
    });
    document.querySelectorAll('pre.astro-code').forEach((pre) => {
      const wrapper = document.createElement('div');
      wrapper.className = 'code-wrapper';
      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.append(pre);
      const button = document.createElement('button');
      button.className = 'copy-button';
      button.textContent = 'Copy';
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(
            pre.querySelector('code')?.textContent ?? '',
          );
          button.textContent = 'Copied';
        } catch {
          button.textContent = 'Select & copy';
        }
        setTimeout(() => {
          button.textContent = 'Copy';
        }, 2000);
      });
      wrapper.append(button);
    });
  </script>
</Base>
